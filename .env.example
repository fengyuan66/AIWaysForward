# Copy to .env.local (local dev) or set these in your host's environment settings (Netlify / Vercel / …).
# Both values are PUBLIC by design — they ship in the browser bundle. What protects the data is Row Level
# Security in supabase/schema.sql, not secrecy of the key. Never put the service_role key here.
#
# Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
